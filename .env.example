# Copy this file to `.env` and fill in your own keys.
# `.env` is git-ignored, so your keys are never committed.

# --- LLM (query understanding + relevance classification) ---
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# --- Google search results (discovery source for most platforms) ---
# https://serper.dev -> 2,500 free queries, no credit card
SERPER_API_KEY=

# --- YouTube Data API v3 (official channel search) ---
# https://console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key
# Optional: without it, YouTube channels are discovered through Google search instead.
YOUTUBE_API_KEY=

# --- Tuning (optional, defaults shown) ---
MAX_RESULTS_PER_QUERY=10
MAX_QUERIES_PER_PLATFORM=2
MAX_WEBSITES_TO_ENRICH=6
MAX_PROSPECTS=50
PLATFORM_TIMEOUT_SECONDS=25
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO
